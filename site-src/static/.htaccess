# Быки News — переадресация на https://bikinews.ru (без www)
<IfModule mod_rewrite.c>
RewriteEngine On

# http -> https. Переадресуем, только если ни один признак не говорит о https,
# чтобы за прокси хостинга не получилась бесконечная переадресация.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
RewriteCond %{HTTP:HTTPS} !=on [NC]
RewriteRule ^(.*)$ https://bikinews.ru/$1 [R=301,L]

# www.bikinews.ru -> bikinews.ru
RewriteCond %{HTTP_HOST} ^www\.bikinews\.ru$ [NC]
RewriteRule ^(.*)$ https://bikinews.ru/$1 [R=301,L]
</IfModule>

# календарь матчей
AddType text/calendar .ics

# Кэш: страницы и данные браузер и приложение каждый раз сверяют с сервером (иначе после обновления сайта показывается старая версия),
# шрифты и картинки берут из кэша неделю
<IfModule mod_headers.c>
<FilesMatch "\.(html|json|xml|ics|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(woff2?|png|jpe?g|webp|svg|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

# Безопасность (по отчёту проверки от 24.10.2026): принудительный https, запрет угадывания типа файла,
# запрет встраивания сайта во фрейм на чужих страницах, короткий Referer для внешних переходов.
# HSTS без includeSubDomains и preload — на поддомены не влияет.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=15552000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>
